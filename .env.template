# =================================================================
# CRA CHATBOT - ENVIRONMENT VARIABLES TEMPLATE
# =================================================================
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to version control
# =================================================================

# -------------------------
# LLM Provider API Keys
# -------------------------

# Anthropic (Claude 3.5 Sonnet for response generation)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (for embeddings: text-embedding-3-large)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# -------------------------
# Vector Database
# -------------------------

# Qdrant Cloud (vector database for document storage)
# Get your credentials at: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Optional: For local Qdrant development
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# -------------------------
# Reranking Service
# -------------------------

# Cohere (for Rerank v3.5)
# Get your key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# -------------------------
# Monitoring & Observability
# -------------------------

# Langfuse (for monitoring, hallucination detection)
# Get your credentials at: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com  # or self-hosted URL

# -------------------------
# Optional Services
# -------------------------

# Redis/Upstash (for caching - optional)
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=your_upstash_url_here
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# -------------------------
# Application Configuration
# -------------------------

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# -------------------------
# RAG Configuration
# -------------------------

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# LLM Model
LLM_MODEL=claude-3-5-sonnet-20240620
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Retrieval Settings
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.7
CONFIDENCE_THRESHOLD=0.6

# Chunking Strategy
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# -------------------------
# Database (for metadata)
# -------------------------

# SQLite (local development)
DATABASE_URL=sqlite:///./cra_chatbot.db

# PostgreSQL (production - optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/cra_chatbot

# -------------------------
# Data Collection
# -------------------------

# Web Scraping Settings
SCRAPER_DELAY_SECONDS=2
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_SECONDS=30

# User Agent for CRA website scraping
USER_AGENT=Mozilla/5.0 (compatible; CRA-ChatbotResearch/1.0; +https://github.com/yourproject)

# -------------------------
# Testing & Evaluation
# -------------------------

# Ground Truth Dataset Path
GROUND_TRUTH_PATH=./data/ground_truth/phase1_qa.json

# Evaluation Metrics
ENABLE_AUTO_EVALUATION=true
EVALUATION_SAMPLE_SIZE=100

# -------------------------
# Cost Tracking
# -------------------------

# Enable cost tracking
TRACK_COSTS=true

# Monthly budget alert (in USD)
MONTHLY_BUDGET_ALERT=300

# -------------------------
# Security
# -------------------------

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS Settings (for web interface)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# -------------------------
# Feature Flags
# -------------------------

# Enable/disable features for testing
ENABLE_RERANKING=true
ENABLE_HALLUCINATION_DETECTION=true
ENABLE_PROMPT_CACHING=true
ENABLE_QUERY_CACHING=true

# -------------------------
# Notes
# -------------------------
# 1. Never commit the .env file to version control
# 2. Keep API keys secure and rotate them regularly
# 3. Use different keys for development/staging/production
# 4. Monitor API usage to avoid unexpected costs
# 5. Some services offer free tiers - start there for development
